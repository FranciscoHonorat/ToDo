server {
    listen 8080;
    root /usr/share/nginx/html;

    # /api/tasks -> ${API_URL}/tasks (a barra final remove o prefixo /api)
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
